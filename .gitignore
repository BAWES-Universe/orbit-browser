# Dependencies
node_modules/
# node_modules may be a SYMLINK to a shared dep cache (e.g. /tmp/tsdeps).
# A trailing-slash pattern only matches real dirs, so also match the symlink
# itself — otherwise `git add -A` re-commits it (broke CI twice, see 8e163b7).
**/node_modules
web-app/node_modules
.pnp/
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo
.next/
out/

# PWA / Workbox generated
web-app/dev-dist/

# Playwright
web-app/test-results/
web-app/playwright-report/
web-app/.last-run.json

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Coverage
coverage/

# Shell builds
shells/*/build/
shells/*/DerivedData/
shells/ios/*.xcworkspace/xcuserdata/
shells/ios/*.xcodeproj/xcuserdata/
shells/macos/*.xcodeproj/xcuserdata/

# macOS shell (Q-ORBIT-01): SwiftPM artifacts + assembled app bundles
shells/macos/OrbitBrowser/.build/
shells/macos/OrbitBrowser/.swiftpm/
shells/macos/**/*.app/
shells/macos/OrbitBrowser/*.app/
