{
  "expo": {
    "name": "Orbit Browser",
    "slug": "orbit-browser",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "orbitbrowser",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bawes.orbitbrowser",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },
    "extra": {
      "shell": "thin-wkwebview",
      "bridgeContract": "@orbit/shell-shared"
    }
  }
}
