# Orbit Browser — web-app environment
#
# Universe entry link — the "one door" into the BAWES Universe. Preloaded by
# the identity layer (see src/identity/deviceIdentity.ts). Override per
# environment; both a bare `UNIVERSE_URL` and Vite's `VITE_UNIVERSE_URL` work,
# with the in-code default being https://play.bawes.
UNIVERSE_URL=https://play.bawes
